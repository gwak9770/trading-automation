# Explicitly public examples and deterministic fixtures; review before adding
!**/api_keys.example.json
!**/token.example.json
!**/settings.local.example.json
!tests/fixtures/**/*.db
!tests/fixtures/**/*.sqlite
!tests/fixtures/**/*.sqlite3
!data/examples/**/*.db
!data/examples/**/*.sqlite
!data/examples/**/*.sqlite3
